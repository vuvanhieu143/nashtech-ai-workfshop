{
    "name": "nashtech-ai-workshop/url-shortener",
    "description": "NashTech AI-Native Workshop URL Shortener",
    "type": "project",
    "require": {
        "php": "^8.4",
        "slim/slim": "^4.15",
        "slim/psr7": "^1.7",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}