{
    "name": "nashtech-ai-workshop-url-shortener",
    "version": "1.0.0",
    "private": true,
    "description": "Frontend dependencies and tooling for the NashTech AI-Native Workshop URL Shortener",
    "scripts": {
        "build": "npm run build:css && npm run build:js",
        "build:css": "tailwindcss -i ./resources/css/app.css -o ./public/assets/app.css --minify",
        "build:js": "esbuild resources/js/app.js --bundle --minify --outfile=public/assets/app.js",
        "test": "playwright test",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui"
    },
    "dependencies": {
        "alpinejs": "^3.15.8"
    },
    "devDependencies": {
        "@playwright/test": "^1.54.2",
        "@tailwindcss/cli": "^4.1.12",
        "esbuild": "^0.25.9",
        "tailwindcss": "^4.1.12"
    }
}